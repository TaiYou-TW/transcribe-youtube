# M3 轉錄服務設定 (cp .env.example .env)
# 產生 token: openssl rand -hex 24
TRANSCRIBE_TOKEN=change-me
PORT=8000
# auto/cpp/mlx/faster; Apple Silicon 上 auto = cpp (whisper.cpp)
WHISPER_BACKEND=cpp
# 覆寫 ja 用的模型 (別名、HF repo id, 或 cpp 用 <owner>/<repo>/<檔名> / 本機 .bin 路徑)
# WHISPER_MODEL=
# 覆寫其他語言 / auto 用的模型 (預設 large-v3-turbo q8_0; 未量化版: ggerganov/whisper.cpp/ggml-large-v3-turbo.bin)
# WHISPER_MODEL_OTHER=
# 排隊上限 (不含執行中), 超過回 429
# QUEUE_MAX=5
# 完成的 job 保留秒數
# JOB_TTL=3600
